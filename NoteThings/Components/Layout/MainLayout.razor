@inherits LayoutComponentBase

<div class="flex flex-col h-screen w-screen bg-[#1e1e1e] text-[#d4d4d4] overflow-hidden select-none">

    <!-- Menu Bar -->
    <div class="flex items-center h-8 bg-[#2d2d2d] border-b border-[#3c3c3c] text-sm shrink-0">
        <span class="px-3 font-semibold text-[#d4d4d4] tracking-wide">NoteThings</span>
        <div class="flex">
            @foreach (var item in new[] { "File", "Edit", "View", "Help" })
            {
                <button class="px-3 h-8 hover:bg-[#3c3c3c] transition-colors">@item</button>
            }
        </div>
    </div>

    <!-- Tab Bar -->
    <div class="flex items-end h-9 bg-[#252526] border-b border-[#3c3c3c] shrink-0 overflow-x-auto">
        <div class="flex items-end h-full">
            <div class="flex items-center h-full px-4 bg-[#1e1e1e] border-t-2 border-t-[#007acc] border-r border-r-[#3c3c3c] text-sm gap-2 cursor-pointer">
                <span>Untitled 1</span>
                <button class="text-[#858585] hover:text-[#d4d4d4] transition-colors text-xs">✕</button>
            </div>
        </div>
        <button class="px-3 h-8 text-[#858585] hover:text-[#d4d4d4] hover:bg-[#3c3c3c] transition-colors text-lg leading-none mb-0.5">+</button>
    </div>

    <!-- Editor Area -->
    <main class="flex-1 overflow-hidden">
        @Body
    </main>

    <!-- Status Bar -->
    <div class="flex items-center justify-between h-6 bg-[#007acc] text-white text-xs px-3 shrink-0">
        <div class="flex items-center gap-4">
            <span>Ln 1, Col 1</span>
        </div>
        <div class="flex items-center gap-4">
            <span>Plain Text</span>
            <span>UTF-8</span>
        </div>
    </div>

</div>
