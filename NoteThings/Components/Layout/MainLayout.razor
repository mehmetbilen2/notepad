@inherits LayoutComponentBase

<div class="flex flex-col h-screen w-screen bg-[#1e1e1e] text-[#cccccc] overflow-hidden font-sans">

    <!-- Menu Bar -->
    <div class="flex items-center h-9 bg-[#3c3c3c] border-b border-black/30 text-[13px] shrink-0 select-none">
        <span class="px-3 font-semibold text-white tracking-tight">NoteThings</span>
        <div class="flex h-full">
            @foreach (var item in new[] { "File", "Edit", "View", "Help" })
            {
                <button class="px-3 h-full hover:bg-white/10 active:bg-white/15 transition-colors">@item</button>
            }
        </div>
    </div>

    <!-- Tab Bar + Editor (managed per-page) -->
    <main class="flex-1 flex flex-col overflow-hidden bg-[#1e1e1e] min-h-0">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="h-full w-full overflow-auto p-4 text-[#f48771] font-mono text-xs bg-[#1e1e1e]">
                    <div class="text-base font-semibold mb-2 text-[#ff6b6b]">Error</div>
                    <div class="mb-2 text-[#cccccc]">@ex.GetType().FullName: @ex.Message</div>
                    <pre class="whitespace-pre-wrap break-all text-[#858585]">@ex.ToString()</pre>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <!-- Status Bar -->
    <div class="flex items-center justify-between h-6 bg-[#0e639c] text-white text-[12px] px-3 shrink-0 select-none">
        <div class="flex items-center gap-4">
            <span>Ln 1, Col 1</span>
        </div>
        <div class="flex items-center gap-4">
            <span>Plain Text</span>
            <span>UTF-8</span>
        </div>
    </div>

</div>
